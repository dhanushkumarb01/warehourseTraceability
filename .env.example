# WareTrace — Docker Compose configuration.
# Copy to `.env` (git-ignored). The defaults below run the whole stack locally;
# replace every secret before exposing anything beyond your machine.

# --- Database (local postgres container) ------------------------------------
POSTGRES_USER=waretrace
POSTGRES_PASSWORD=waretrace
POSTGRES_DB=warehouse_traceability

# --- Host ports ---------------------------------------------------------------
BACKEND_PORT=5000
FRONTEND_PORT=8088
AI_WORKER_PORT=8600

# --- Backend ------------------------------------------------------------------
# Comma-separated CORS allow-list; must contain the origin you open in the browser.
FRONTEND_URL=http://localhost:8088
# Signs login JWTs.  Generate: openssl rand -hex 32
JWT_SECRET=local-dev-jwt-secret-change-me
# Encrypts camera passwords at rest; empty = derived from JWT_SECRET.  Generate: openssl rand -hex 32
CAMERA_ENC_KEY=
# mock = built-in simulated SAP | http = real SAP gateway (see docs/SAP_INTEGRATION_SPEC.md)
SAP_MODE=mock

# First admin, read only by `docker compose run --rm backend npm run seed:admin`.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- Frontend (build time) ------------------------------------------------------
# The browser calls this URL directly; rebuild the frontend image after changing it.
VITE_API_BASE_URL=http://localhost:5000/api

# --- AI worker ------------------------------------------------------------------
# Shared secret between backend and worker (X-Service-Token header).  Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=local-dev-service-token-change-me
# Backend the worker pulls camera jobs from. Default: the backend container.
# To serve a cloud backend instead, set its URL here and use that backend's AI_SERVICE_TOKEN.
WARETRACE_API_URL=http://backend:5000
AI_LOG_LEVEL=INFO

# --- ngrok (only for `docker compose --profile tunnel up`) ----------------------
# Authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Your static domain from https://dashboard.ngrok.com/domains
NGROK_DOMAIN=alexia-intertribal-nonsubtractively.ngrok-free.dev
