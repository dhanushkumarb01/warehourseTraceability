# WareTrace AI Surveillance service configuration.
# Copy to `.env`. NEVER commit the real .env.

# Backend the worker pulls camera jobs from and reports alerts to.
WARETRACE_API_URL=http://localhost:5000

# MUST match AI_SERVICE_TOKEN in backend/.env (shared service secret).
AI_SERVICE_TOKEN=CHANGE_ME_shared_service_token

# Cadence (seconds)
AI_JOB_REFRESH_SEC=20
AI_HEARTBEAT_SEC=10

# Performance
AI_FRAME_WIDTH=640
AI_TARGET_FPS=8

# Reconnection (seconds)
AI_RECONNECT_DELAY_SEC=3
AI_MAX_RECONNECT_DELAY_SEC=30

# HTTP / logging
AI_HTTP_TIMEOUT_SEC=8
AI_LOG_LEVEL=INFO

# Face-enrollment HTTP API the backend calls (backend AI_ENROLLMENT_URL must point here)
# AI_ENROLL_HOST=0.0.0.0
# AI_ENROLL_PORT=8600
# AI_FACE_MIN_DET_SCORE=0.5
# AI_FACE_REFRESH_SEC=30
