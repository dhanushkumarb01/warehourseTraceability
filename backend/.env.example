# WareTrace backend configuration.
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database (PostgreSQL) ---------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/warehouse_traceability"

# --- Frontend / CORS ---------------------------------------------------------
# Comma-separated list of allowed frontend origins (protocol + host + port).
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# --- Authentication ----------------------------------------------------------
# Long random string used to sign JWTs.  Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_long_random_string
# Access-token lifetime (default 8h)
# JWT_EXPIRES_IN=8h
# bcrypt cost factor (default 12)
BCRYPT_SALT_ROUNDS=12

# Shared secret between this backend and the Python ai-service.
# MUST be identical to AI_SERVICE_TOKEN in ai-service/.env.  Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=CHANGE_ME_shared_service_token

# Optional: dedicated key for encrypting camera passwords at rest.
# If empty it is derived from JWT_SECRET.  Generate: openssl rand -hex 32
# CAMERA_ENC_KEY=

# --- First-admin bootstrap (read by `npm run seed:admin`) ---------------------
# Set these only when running the seed; remove them afterwards.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- SAP integration ---------------------------------------------------------
# mock = built-in simulated SAP (default) | http = real SAP gateway
SAP_MODE=mock
SAP_BLOCK_ON_UNAVAILABLE=false
SAP_MAX_RETRIES=3
SAP_RETRY_BASE_DELAY_MS=200
# Only needed when SAP_MODE=http
SAP_BASE_URL=
SAP_API_KEY=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# --- Face enrollment (ai-service HTTP endpoint) ------------------------------
# AI_ENROLLMENT_URL=http://localhost:8600
